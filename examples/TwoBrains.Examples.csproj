<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>TwoBrains.Examples</AssemblyName>
    <RootNamespace>TwoBrains.Examples</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>14</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Isolated per-lane intermediate dirs (obj.*) used by parallel agents must never be compiled. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj*/**;bin*/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Shared-source: compile the core library directly (single source of truth),
       excluding the s&box engine adapter — the examples are engine-free. -->
  <ItemGroup>
    <Compile Include="..\Code\SboxTwoBrains\**\*.cs" Exclude="..\Code\SboxTwoBrains\Sandbox\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
